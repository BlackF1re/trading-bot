# ============================================================
# Trading Bot — paper mode configuration
# Copy this file to .env only if you want to change defaults.
# No wallet or private key is required.
# ============================================================

# Paper position sizes. Each size is evaluated independently.
TRADE_SIZES_USDT=10,25,50,100,250

# How often a full scan starts. Minimum: 1000 ms.
POLL_INTERVAL_MS=5000

# A paper execution starts when estimated net edge is at least this value.
MIN_SIGNAL_PCT=0.10

# STON.fi simulation tolerance: 0.005 = 0.5%.
STON_SLIPPAGE_TOLERANCE=0.005

# Delayed paper-execution model.
DETECTION_TO_EXECUTION_MS=1200
BETWEEN_LEGS_MS=2500
EVENT_COOLDOWN_MS=20000

# Native Gram (formerly Toncoin) is the gas currency.
# This is a configurable reserve estimate, not a measured transaction fee.
ESTIMATED_GAS_PER_LEG_GRAM=0.05
SAFETY_BUFFER_BPS=10

# Official USD₮ jetton master on TON.
USDT_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# Read-only TON v4 endpoint used by the DeDust SDK.
TON_V4_ENDPOINT=https://mainnet-v4.tonhubapi.com

# Local web dashboard. 127.0.0.1 means it is reachable only from this PC.
UI_ENABLED=true
UI_HOST=127.0.0.1
UI_PORT=3000

# Used by Windows start.bat. Leave false in .env; start.bat overrides it for one run.
AUTO_OPEN_BROWSER=false

DATA_DIR=./data
VERBOSE_ERRORS=false
